# Normalize line endings: store LF in the repo, check out native on each OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.class binary

# Generated files excluded from language stats / merge noise.
gradlew text eol=lf
*.lock linguist-generated=true
